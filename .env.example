# GhostRep local development
# Copy to .env and adjust. Never commit real keys.

# --- Application ---
APP_ENV=development
APP_MODE=real
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE=ghostrep_session
# Session cookie: HttpOnly, SameSite=Lax, Secure only when FRONTEND_ORIGIN is https.
# Split frontend/API hosts will not send Lax cookies. Prefer one reverse-proxied origin.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/ghostrep.db
DATA_DIR=./data
RETENTION_HOURS=24
RETAIN_RAW_VIDEO=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=real

# --- Zero-credit Meta controls (default: no paid calls) ---
# Workout and coaching inherit AI_PROVIDER when their own value is empty.
# Segmentation does not: it stays off until SEGMENTATION_PROVIDER is set.
AI_PROVIDER=local
WORKOUT_PROVIDER=local
COACHING_PROVIDER=local
SEGMENTATION_PROVIDER=none
SAM_INCLUDE_BARBELL=false
ENABLE_META_API=false
META_REQUIRE_EXPLICIT_APPROVAL=true
# No application call, spend, or completion-token caps by default.
# Optional operator controls, only if you choose to impose a limit:
# META_MAX_CALLS_PER_SESSION=100
# META_ESTIMATED_SPEND_LIMIT_USD=100
META_REQUEST_TIMEOUT_SECONDS=180
META_MAX_RETRIES=2
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# A key never starts a paid call. Live inference also needs ENABLE_META_API=true,
# the matching provider set to meta_live, and an explicit approval token.
# A local failure never falls through to a paid provider.
